# Copy sang backend/.env rồi điền giá trị thật. File .env KHÔNG được commit.

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
# BẮT BUỘC - không có giá trị mặc định trong code, thiếu là backend không start
DB_PASSWORD=
DB_NAME=house_design
DB_SSLMODE=disable

# Application Configuration
# BẮT BUỘC - tối thiểu 32 ký tự, không được để giá trị mặc định cũ.
# Sinh bằng: openssl rand -base64 48
# Lưu ý: đổi giá trị này sẽ vô hiệu hoá mọi token admin đang đăng nhập.
JWT_SECRET=

# Server Configuration
SERVER_PORT=8080
# Mặc định 127.0.0.1 - chỉ nginx gọi được. Đặt 0.0.0.0 nếu thật sự cần phơi ra ngoài.
SERVER_HOST=127.0.0.1

# GIN_MODE KHÔNG đặt ở đây được: gin đọc biến này lúc package init, chạy trước
# config.LoadEnv(). Đặt trong systemd unit qua Environment=GIN_MODE=release.
